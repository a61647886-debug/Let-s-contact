@app.route("/search", methods=["GET"])
def search_users():
    if "user" not in session:
        return redirect("/login")

    query = request.args.get("q", "").strip()
    results = []

    con = get_db()
    current_user = con.execute("SELECT id FROM users WHERE username = ?", (session["user"],)).fetchone()

    if query:
        results = con.execute("""
            SELECT id, username
            FROM users
            WHERE username LIKE ?
              AND username != ?
              AND username != 'admin'
              AND is_suspended = 0
            ORDER BY username ASC
            LIMIT 50
        """, ('%' + query + '%', session["user"])).fetchall()

    following_ids = set()
    if current_user:
        f_rows = con.execute("SELECT following_id FROM follows WHERE follower_id = ?", (current_user["id"],)).fetchall()
        for r in f_rows:
            following_ids.add(r["following_id"])

    con.close()

    result_html = ""
    for user in results:
        is_following = user["id"] in following_ids
        btn_text = "Unfollow" if is_following else "Follow"
        btn_class = "dislike-button" if is_following else "primary"

        result_html += f"""
        <div class="user-result">
            <div>
                <strong>👤 {user['username']}</strong>
            </div>
            <div style="display: flex; gap: 8px;">
                <form method="POST" action="/follow/{user['id']}" style="margin:0;">
                    <button class="{btn_class}">{btn_text}</button>
                </form>
                <a href="/message/{user['id']}">
                    <button class="neutral-button">💬 Message</button>
                </a>
            </div>
        </div>
        """

    if query and not results:
        result_html = '<p class="small">No users found.</p>'

    return page(f"""
        <div class="card">
            <h2>🔎 Search Users & Follow</h2>
            <form method="GET" action="/search">
                <div class="search-box">
                    <input name="q" value="{query}" placeholder="Search username..." required>
                    <button class="primary">Search</button>
                </div>
            </form>
        </div>
        <div class="card">
            <h2>👥 Search Results</h2>
            {result_html}
        </div>
    """)


@app.route("/follow/<int:user_id>", methods=["POST"])
def follow_user(user_id):
    if "user" not in session:
        return redirect("/login")

    con = get_db()
    current_user = con.execute("SELECT id FROM users WHERE username = ?", (session["user"],)).fetchone()

    if not current_user or current_user["id"] == user_id:
        con.close()
        return redirect(request.referrer or "/")

    existing = con.execute("""
        SELECT * FROM follows WHERE follower_id = ? AND following_id = ?
    """, (current_user["id"], user_id)).fetchone()

    if existing:
        con.execute("DELETE FROM follows WHERE follower_id = ? AND following_id = ?", (current_user["id"], user_id))
    else:
        con.execute("INSERT INTO follows(follower_id, following_id) VALUES (?, ?)", (current_user["id"], user_id))

    con.commit()
    con.close()
    return redirect(request.referrer or "/")


