@app.route("/message/<int:user_id>", methods=["GET", "POST"])
def message_user(user_id):
    if "user" not in session:
        return redirect("/login")

    con = get_db()
    current_user = con.execute("SELECT id, username FROM users WHERE username = ?", (session["user"],)).fetchone()
    other_user = con.execute("SELECT id, username FROM users WHERE id = ? AND is_suspended = 0", (user_id,)).fetchone()

    if not current_user or not other_user or current_user["id"] == other_user["id"]:
        con.close()
        return redirect("/search")

    if request.method == "POST":
        text = request.form.get("message", "").strip()
        if text:
            text = text[:5000]
            con.execute("""
                INSERT INTO messages(sender_id, receiver_id, message)
                VALUES (?, ?, ?)
            """, (current_user["id"], other_user["id"], text))
            con.commit()
        con.close()
        return redirect(f"/message/{user_id}")

    messages = con.execute("""
        SELECT messages.*, sender.username AS sender_name
        FROM messages
        JOIN users AS sender ON messages.sender_id = sender.id
        WHERE (messages.sender_id = ? AND messages.receiver_id = ?)
           OR (messages.sender_id = ? AND messages.receiver_id = ?)
        ORDER BY messages.id ASC
    """, (current_user["id"], other_user["id"], other_user["id"], current_user["id"])).fetchall()

    con.close()

    chat_html = ""
    for msg in messages:
        message_class = "mine" if msg["sender_id"] == current_user["id"] else ""
        chat_html += f"""
        <div class="message {message_class}">
            <div>
                <div class="message-bubble">{msg['message']}</div>
                <div class="message-time">{msg['created_at']}</div>
            </div>
        </div>
        """

    if not chat_html:
        chat_html = '<p class="small">No messages yet. Say hello! 👋</p>'

    return page(f"""
        <div class="card">
            <h2>💬 Chat with {other_user['username']}</h2>
            <div class="chat-box">{chat_html}</div>
            <form method="POST" class="chat-form">
                <textarea name="message" placeholder="Write a message..." maxlength="5000" required></textarea>
                <button class="primary">➤ Send</button>
            </form>
        </div>
    """)


