@app.route("/profile")
def profile():
    if "user" not in session or session["user"] == "admin":
        return redirect("/login")

    con = get_db()
    current_user = con.execute("SELECT * FROM users WHERE username = ?", (session["user"],)).fetchone()
    if not current_user:
        con.close()
        return redirect("/logout")

    user_id = current_user["id"]

    posts = con.execute("""
        SELECT posts.*, 
        (SELECT COUNT(*) FROM reactions WHERE reactions.post_id = posts.id AND reaction='like') as likes,
        (SELECT COUNT(*) FROM reactions WHERE reactions.post_id = posts.id AND reaction='dislike') as dislikes
        FROM posts WHERE user_id = ? ORDER BY id DESC
    """, (user_id,)).fetchall()

    totals = con.execute("""
        SELECT 
        SUM(CASE WHEN reactions.reaction = 'like' THEN 1 ELSE 0 END) as total_likes,
        SUM(CASE WHEN reactions.reaction = 'dislike' THEN 1 ELSE 0 END) as total_dislikes
        FROM posts
        LEFT JOIN reactions ON posts.id = reactions.post_id
        WHERE posts.user_id = ?
    """, (user_id,)).fetchone()

    total_likes = totals["total_likes"] or 0
    total_dislikes = totals["total_dislikes"] or 0

    followers_count = con.execute("SELECT COUNT(*) as cnt FROM follows WHERE following_id = ?", (user_id,)).fetchone()["cnt"]
    following_count = con.execute("SELECT COUNT(*) as cnt FROM follows WHERE follower_id = ?", (user_id,)).fetchone()["cnt"]

    follower_list = con.execute("""
        SELECT users.username FROM follows
        JOIN users ON follows.follower_id = users.id
        WHERE follows.following_id = ?
    """, (user_id,)).fetchall()

    con.close()

    posts_html = ""
    for p in posts:
        if p["media_type"] == "image":
            media = f'<img src="/uploads/{p["filename"]}" alt="Media">'
        else:
            media = f'<video controls><source src="/uploads/{p["filename"]}">Your browser does not support video.</video>'

        posts_html += f"""
        <div class="card" style="margin-top: 15px;">
            <div class="post-title">{p['title'] if p['title'] else 'Untitled'}</div>
            {media}
            <div class="reactions" style="margin-top: 10px;">
                <span class="count">👍 {p['likes']}</span>
                <span class="count">👎 {p['dislikes']}</span>
            </div>
        </div>
        """

    if not posts_html:
        posts_html = '<p class="small">Apni ekhono kono post upload করেননি।</p>'

    followers_names = ", ".join([f["username"] for f in follower_list]) if follower_list else "Keu nei"

    return page(f"""
        <div class="card">
            <h2>👤 Amar Profile ({current_user['username']})</h2>
            <p><strong>bKash Number:</strong> {current_user['bkash_number'] if current_user['bkash_number'] else 'Set kora nei (Monetization page theke set korun)'}</p>
            <p><strong>Followers:</strong> {followers_count} | <strong>Following:</strong> {following_count}</p>
            <p><strong>Total Likes Received:</strong> 👍 {total_likes} | <strong>Total Dislikes Received:</strong> 👎 {total_dislikes}</p>
            <p><strong>Followers List:</strong> {followers_names}</p>
        </div>
        <h2>🖼️ Amar Upload kora Post-gulo</h2>
        {posts_html}
    """)


