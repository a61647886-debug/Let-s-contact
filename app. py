# =========================================================
# DATABASE (Safe Migration)
# =========================================================

def get_db():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con


def init_db():

    con = get_db()

    # USERS
    con.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            is_suspended INTEGER DEFAULT 0,
            bkash_number TEXT
        )
    """)

    try:
        con.execute("ALTER TABLE users ADD COLUMN is_suspended INTEGER DEFAULT 0")
    except sqlite3.OperationalError:
        pass

    try:
        con.execute("ALTER TABLE users ADD COLUMN bkash_number TEXT")
    except sqlite3.OperationalError:
        pass

    # Default Admin account creation
    admin_hash = generate_password_hash("secret123")
    con.execute("""
        INSERT OR IGNORE INTO users (username, password)
        VALUES ('admin', ?)
    """, (admin_hash,))

    # POSTS
    con.execute("""
        CREATE TABLE IF NOT EXISTS posts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            title TEXT,
            filename TEXT NOT NULL,
            original_name TEXT NOT NULL,
            media_type TEXT NOT NULL
        )
    """)

    try:
        con.execute("ALTER TABLE posts ADD COLUMN title TEXT")
    except sqlite3.OperationalError:
        pass

    # REACTIONS
    con.execute("""
        CREATE TABLE IF NOT EXISTS reactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            post_id INTEGER NOT NULL,
            reaction TEXT NOT NULL,
            UNIQUE(user_id, post_id)
        )
    """)

    # COMMENTS (with parent_id for replies)
    con.execute("""
        CREATE TABLE IF NOT EXISTS comments (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            post_id INTEGER NOT NULL,
            comment TEXT NOT NULL,
            parent_id INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)

    try:
        con.execute("ALTER TABLE comments ADD COLUMN parent_id INTEGER")
    except sqlite3.OperationalError:
        pass

    # REPORTS
    con.execute("""
        CREATE TABLE IF NOT EXISTS reports (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            post_id INTEGER NOT NULL,
            UNIQUE(user_id, post_id)
        )
    """)

    # FOLLOWS
    con.execute("""
        CREATE TABLE IF NOT EXISTS follows (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            follower_id INTEGER NOT NULL,
            following_id INTEGER NOT NULL,
            UNIQUE(follower_id, following_id)
        )
    """)

    # MESSAGES
    con.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            sender_id INTEGER NOT NULL,
            receiver_id INTEGER NOT NULL,
            message TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)

    con.commit()
    con.close()


