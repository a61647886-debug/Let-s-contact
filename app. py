@app.route("/comment/<int:post_id>", methods=["POST"])
def comment(post_id):
    if "user" not in session:
        return redirect("/login")

    comment_text = request.form.get("comment", "").strip()
    parent_id = request.form.get("parent_id")
    if not comment_text:
        return redirect("/")

    comment_text = comment_text[:1000]
    con = get_db()
    user = con.execute("SELECT id FROM users WHERE username = ?", (session["user"],)).fetchone()
    post = con.execute("SELECT id FROM posts WHERE id = ?", (post_id,)).fetchone()

    if user and post:
        con.execute("""
            INSERT INTO comments(user_id, post_id, comment, parent_id)
            VALUES (?, ?, ?, ?)
        """, (user["id"], post_id, comment_text, parent_id if parent_id else None))
        con.commit()

    con.close()
    return redirect("/")


