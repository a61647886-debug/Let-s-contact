@app.route("/bkash", methods=["GET", "POST"])
def bkash_setup():
    if "user" not in session or session["user"] == "admin":
        return redirect("/login")

    con = get_db()
    message = ""

    if request.method == "POST":
        bkash = request.form.get("bkash", "").strip()
        con.execute("""
            UPDATE users
            SET bkash_number = ?
            WHERE username = ?
        """, (bkash, session["user"]))
        con.commit()
        message = "bKash number successfully updated!"

    user = con.execute("""
        SELECT bkash_number FROM users WHERE username = ?
    """, (session["user"],)).fetchone()
    con.close()

    current_bkash = user["bkash_number"] if user and user["bkash_number"] else ""

    return page(f"""
        <div class="card">
            <h2>💰 Monetization - bKash Number Setup</h2>
            <p class="success">{message}</p>
