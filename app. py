@app.route("/")
def home():

    if session.get("user") == "admin":
        return redirect("/admin")

    query = request.args.get("q", "").strip()

    con = get_db()

    if query:
        posts = con.execute("""
            SELECT posts.*, users.username
            FROM posts
            JOIN users ON posts.user_id = users.id
            WHERE posts.title LIKE ?
            ORDER BY posts.id DESC
        """, ('%' + query + '%',)).fetchall()
    else:
        posts = con.execute("""
            SELECT posts.*, users.username
            FROM posts
            JOIN users ON posts.user_id = users.id
            ORDER BY posts.id DESC
        """).fetchall()

    comments = con.execute("""
        SELECT comments.*, users.username
        FROM comments
        JOIN users ON comments.user_id = users.id
        ORDER BY comments.id ASC
    """).fetchall()

    reaction_counts = con.execute("""
        SELECT
            post_id,
            SUM(CASE WHEN reaction = 'like' THEN 1 ELSE 0 END) AS likes,
            SUM(CASE WHEN reaction = 'dislike' THEN 1 ELSE 0 END) AS dislikes
        FROM reactions
        GROUP BY post_id
    """).fetchall()

    user_reactions = {}
    user_reports = {}
    following_ids = set()
    current_user_id = None

    if session.get("user"):
        current_user = con.execute("""
            SELECT id FROM users WHERE username = ?
        """, (session["user"],)).fetchone()

        if current_user:
            current_user_id = current_user["id"]
            rows = con.execute("""
                SELECT post_id, reaction FROM reactions WHERE user_id = ?
            """, (current_user_id,)).fetchall()

            for row in rows:
                user_reactions[row["post_id"]] = row["reaction"]

            report_rows = con.execute("""
                SELECT post_id FROM reports WHERE user_id = ?
            """, (current_user_id,)).fetchall()

            for r in report_rows:
                user_reports[r["post_id"]] = True

            f_rows = con.execute("""
                SELECT following_id FROM follows WHERE follower_id = ?
            """, (current_user_id,)).fetchall()
            for r in f_rows:
                following_ids.add(r["following_id"])

    con.close()

    counts = {}
    for row in reaction_counts:
        counts[row["post_id"]] = {
            "likes": row["likes"] or 0,
            "dislikes": row["dislikes"] or 0
        }

    comment_dict = {}
    reply_dict = {}
    for comment in comments:
        post_id = comment["post_id"]
        parent_id = comment["parent_id"]
        if parent_id is None:
            if post_id not in comment_dict:
                comment_dict[post_id] = []
            comment_dict[post_id].append(comment)
        else:
            if parent_id not in reply_dict:
                reply_dict[parent_id] = []
            reply_dict[parent_id].append(comment)

    feed = ""
    for post in posts:
        post_id = post["id"]
        author_id = post["user_id"]

        if post["media_type"] == "image":
            media = f'<img src="/uploads/{post["filename"]}" alt="Media">'
        else:
            media = f'<video controls><source src="/uploads/{post["filename"]}">Your browser does not support video.</video>'

        likes = counts.get(post_id, {}).get("likes", 0)
        dislikes = counts.get(post_id, {}).get("dislikes", 0)
        current_reaction = user_reactions.get(post_id)
        post_title = post['title'] if post['title'] else ""

        follow_button_html = ""
        if session.get("user") and current_user_id and author_id != current_user_id:
            is_following = author_id in following_ids
            follow_text = "Unfollow" if is_following else "Follow"
            follow_class = "dislike-button" if is_following else "primary"
            follow_button_html = f"""
            <form method="POST" action="/follow/{author_id}">
                <button class="{follow_class}">{follow_text}</button>
            </form>
            """

        if session.get("user"):
            like_text = "👍 Unlike" if current_reaction == "like" else "👍 Like"
            dislike_text = "👎 Remove Dislike" if current_reaction == "dislike" else "👎 Dislike"
            report_text = "🚩 Reported" if user_reports.get(post_id) else "🚩 Report"

            reactions_html = f"""
            <div class="reactions">
                <form method="POST" action="/react/{post_id}">
                    <input type="hidden" name="reaction" value="like">
                    <button class="like-button">{like_text}</button>
                </form>
                {follow_button_html}
                <form method="POST" action="/react/{post_id}">
                    <input type="hidden" name="reaction" value="dislike">
                    <button class="dislike-button">{dislike_text}</button>
                </form>
                <form method="POST" action="/report/{post_id}">
                    <button class="report-button">{report_text}</button>
                </form>
                <a href="/download/{post_id}"><button class="neutral-button">📥 Download</button></a>
                <span class="count">👍 {likes}</span>
                <span class="count">👎 {dislikes}</span>
            </div>
            """
        else:
            reactions_html = f"""
            <div class="reactions">
                <a href="/download/{post_id}"><button class="neutral-button">📥 Download</button></a>
                <span class="count">👍 {likes}</span>
                <span class="count">👎 {dislikes}</span>
                <a href="/login"><button class="neutral-button">🔐 Login to react</button></a>
            </div>
            """

        post_comments = comment_dict.get(post_id, [])
        comments_html = ""
        for comment in post_comments:
            c_id = comment["id"]
            replies = reply_dict.get(c_id, [])
            replies_html = ""
            for rep in replies:
                replies_html += f"""
                <div class="comment reply-comment">
                    <div class="comment-user">👤 {rep['username']}</div>
                    <div class="comment-text">{rep['comment']}</div>
                </div>
                """

            reply_form = ""
            if session.get("user"):
                reply_form = f"""
                <form method="POST" action="/comment/{post_id}" style="margin-top: 8px;">
                    <input type="hidden" name="parent_id" value="{c_id}">
                    <input type="text" name="comment" placeholder="Write a reply..." maxlength="500" required style="padding: 8px; margin: 4px 0; font-size: 13px;">
                    <button class="primary" style="padding: 6px 12px; font-size: 12px;">Reply</button>
                </form>
                """

            comments_html += f"""
            <div class="comment">
                <div class="comment-user">👤 {comment['username']}</div>
                <div class="comment-text">{comment['comment']}</div>
                {reply_form}
                {replies_html}
            </div>
            """

        if session.get("user"):
            comment_form = f"""
            <form method="POST" action="/comment/{post_id}">
                <textarea name="comment" placeholder="Write a comment..." maxlength="1000" required></textarea>
                <button class="primary">💬 Comment</button>
            </form>
            """
        else:
            comment_form = '<p class="small"><a href="/login">Login</a> to write a comment.</p>'

        feed += f"""
        <div class="card">
            <div class="user">👤 {post['username']}</div>
            <div class="post-title">{post_title}</div>
            {media}
            <p class="small">Original file: {post['original_name']}</p>
            {reactions_html}
            <div class="comments">
                <h3>💬 Comments</h3>
                {comment_form}
                {comments_html}
            </div>
        </div>
        """

    if not feed:
        feed = '<div class="card"><h2>📭 No posts found</h2><p>Try searching with a different title or be the first to upload!</p></div>'

    if session.get("user"):
        button = '<a href="/upload"><button class="primary">📤 Upload Photo / Video</button></a>'
    else:
        button = '<a href="/register"><button class="primary">🚀 Create Account</button></a>'

    return page(f"""
        <div class="card">
            <h1>Welcome to Let's Contact 👋</h1>
            <p>Share photos and videos with the community.</p>
            {button}
        </div>
        <div class="card">
            <form method="GET" action="/">
                <div class="search-box">
                    <input name="q" value="{query}" placeholder="Search posts by title...">
                    <button class="primary">🔍 Search Posts</button>
                </div>
            </form>
        </div>
        <h2>🌎 Community Feed {f'for "{query}"' if query else ''}</h2>
        {feed}
    """)


