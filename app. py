@app.route("/report/<int:post_id>", methods=["POST"])
def report_post(post_id):
    if "user" not in session:
        return redirect("/login")

    con = get_db()
    current_user = con.execute("SELECT id FROM users WHERE username = ?", (session["user"],)).fetchone()
    post = con.execute("SELECT * FROM posts WHERE id = ?", (post_id,)).fetchone()

    if not current_user or not post:
        con.close()
        return redirect("/")

    try:
        con.execute("INSERT INTO reports(user_id, post_id) VALUES (?, ?)", (current_user["id"], post_id))
        con.commit()
    except sqlite3.IntegrityError:
        pass

    report_count = con.execute("SELECT COUNT(*) as cnt FROM reports WHERE post_id = ?", (post_id,)).fetchone()["cnt"]

    if report_count > 3:
        owner_id = post["user_id"]
        con.execute("UPDATE users SET is_suspended = 1 WHERE id = ?", (owner_id,))

        user_posts = con.execute("SELECT * FROM posts WHERE user_id = ?", (owner_id,)).fetchall()
        for p in user_posts:
            file_path = os.path.join(UPLOAD_DIR, p["filename"])
            if os.path.exists(file_path):
                try:
                    os.remove(file_path)
                except:
                    pass
            con.execute("DELETE FROM comments WHERE post_id = ?", (p["id"],))
            con.execute("DELETE FROM reactions WHERE post_id = ?", (p["id"],))
            con.execute("DELETE FROM reports WHERE post_id = ?", (p["id"],))

        con.execute("DELETE FROM posts WHERE user_id = ?", (owner_id,))
        con.commit()

        owner_username = con.execute("SELECT username FROM users WHERE id = ?", (owner_id,)).fetchone()
        if owner_username and session.get("user") == owner_username["username"]:
            session.clear()

    con.close()
    return redirect("/")


