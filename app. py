@app.route("/react/<int:post_id>", methods=["POST"])
def react(post_id):
    if "user" not in session:
        return redirect("/login")

    reaction = request.form.get("reaction", "")
    if reaction not in {"like", "dislike"}:
        return redirect("/")

    con = get_db()
    user = con.execute("SELECT id FROM users WHERE username = ?", (session["user"],)).fetchone()
    post = con.execute("SELECT id FROM posts WHERE id = ?", (post_id,)).fetchone()

    if not user or not post:
        con.close()
        return redirect("/")

    user_id = user["id"]
    existing = con.execute("""
        SELECT * FROM reactions WHERE user_id = ? AND post_id = ?
    """, (user_id, post_id)).fetchone()

    if existing:
        if existing["reaction"] == reaction:
            con.execute("DELETE FROM reactions WHERE user_id = ? AND post_id = ?", (user_id, post_id))
        else:
            con.execute("UPDATE reactions SET reaction = ? WHERE user_id = ? AND post_id = ?", (reaction, user_id, post_id))
    else:
        con.execute("INSERT INTO reactions(user_id, post_id, reaction) VALUES (?, ?, ?)", (user_id, post_id, reaction))

    con.commit()
    con.close()
    return redirect("/")


