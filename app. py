@app.route("/upload", methods=["GET", "POST"])
def upload():
    if "user" not in session or session["user"] == "admin":
        return redirect("/login")

    message = ""
    if request.method == "POST":
        title = request.form.get("title", "").strip()
        file = request.files.get("file")

        if not title:
            message = "Please enter a title for your post."
        elif len(title) > 100:
            message = "Title must be under 100 characters."
        elif not file or not file.filename:
            message = "Please select a file."
        else:
            original = secure_filename(file.filename)
            if "." not in original:
                message = "Invalid file."
            else:
                ext = original.rsplit(".", 1)[1].lower()
                if ext not in ALLOWED:
                    message = "Allowed: JPG, PNG, GIF, WEBP, MP4 and WEBM."
                else:
                    filename = uuid.uuid4().hex + "." + ext
                    file.save(os.path.join(UPLOAD_DIR, filename))

                    media_type = "image" if ext in {"jpg", "jpeg", "png", "gif", "webp"} else "video"

                    con = get_db()
                    user = con.execute("SELECT id FROM users WHERE username = ?", (session["user"],)).fetchone()
                    if not user:
                        con.close()
                        return redirect("/logout")

                    con.execute("""
                        INSERT INTO posts(user_id, title, filename, original_name, media_type)
                        VALUES (?, ?, ?, ?, ?)
                    """, (user["id"], title, filename, original, media_type))
                    con.commit()
                    con.close()
                    return redirect("/")

    return page(f"""
        <div class="card">
            <h2>📤 Upload Photo or Video</h2>
            <p class="error">{message}</p>
            <form method="POST" enctype="multipart/form-data">
                <input type="text" name="title" placeholder="Enter Post Title (required)" maxlength="100" required>
                <input type="file" name="file" accept="image/*,video/*" required>
                <button class="primary">Upload</button>
            </form>
            <p class="small">JPG, PNG, GIF, WEBP, MP4, WEBM</p>
        </div>
    """)


