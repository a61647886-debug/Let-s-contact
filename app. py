@app.route("/admin")
def admin_panel():
    if session.get("user") != "admin":
        return redirect("/login")

    con = get_db()
    users = con.execute("""
        SELECT u.id, u.username, u.bkash_number, u.is_suspended,
               (SELECT COUNT(*) FROM follows WHERE following_id = u.id) AS followers_count,
               (SELECT SUM(CASE WHEN reactions.reaction = 'like' THEN 1 ELSE 0 END) 
                FROM posts 
                LEFT JOIN reactions ON posts.id = reactions.post_id 
                WHERE posts.user_id = u.id) AS total_likes
        FROM users u
        WHERE u.username != 'admin'
        ORDER BY u.id DESC
    """).fetchall()
    con.close()

    rows_html = ""
    for u in users:
        bkash = u["bkash_number"] if u["bkash_number"] else "Not provided"
        status = "Suspended" if u["is_suspended"] == 1 else "Active"
        likes = u["total_likes"] if u["total_likes"] else 0
        followers = u["followers_count"] if u["followers_count"] else 0
        rows_html += f"""
        <tr>
            <td>{u['username']}</td>
            <td>{bkash}</td>
            <td>👍 {likes}</td>
            <td>👥 {followers}</td>
            <td>{status}</td>
        </tr>
        """

    if not rows_html:
        rows_html = '<tr><td colspan="5">No users found.</td></tr>'

    return page(f"""
        <div class="card">
            <h2>🛡️ Admin Dashboard - Monetization & User Stats</h2>
            <p class="small">Here you can view user bKash numbers, total likes, followers count, and status.</p>
            <table>
                <tr>
                    <th>Username</th>
                    <th>bKash Number</th>
                    <th>Total Likes</th>
                    <th>Followers</th>
                    <th>Status</th>
                </tr>
                {rows_html}
            </table>
        </div>
    """)


